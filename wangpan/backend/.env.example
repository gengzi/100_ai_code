# 百度网盘API配置
# 需要在百度开放平台申请: https://pan.baidu.com/union/doc/0ksg0sbig
BAIDU_APP_KEY=your_app_key_here
BAIDU_SECRET_KEY=your_secret_key_here
BAIDU_ACCESS_TOKEN=your_access_token_here

# 服务器配置
HOST=0.0.0.0
PORT=5000

# 下载配置
DOWNLOAD_DIR=downloads
MAX_CONCURRENT_DOWNLOADS=3

# F2配置文件路径（可选）
# 如果不指定，将使用项目中的 f2_config.yaml
# F2_CONFIG_PATH=/path/to/your/custom_f2_config.yaml

# TikHub API配置（可选但推荐）
# TikHub提供稳定的抖音API服务，免费额度: https://tikhub.io/
# 注册并获取API Key: https://beta-web.tikhub.io/users/signup?referral_code=6hLcGD94
TIKHUB_API_KEY=your_tikhub_api_key_here

# 抖音Cookie（可选，用于下载需要登录的视频）
# 如何获取Cookie:
# 1. 在浏览器中打开抖音网页版并登录
# 2. 按F12打开开发者工具
# 3. 切换到Network标签
# 4. 刷新页面
# 5. 找到任意请求，查看请求头中的Cookie
# DOUYIN_COOKIE=your_douyin_cookie_here

# 代理设置（可选）
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# 日志配置
LOG_LEVEL=INFO
